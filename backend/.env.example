# Server
PORT=5000
NODE_ENV=development

# Database (SQLite - local file)
# DB file is stored at: backend/data/chws_dashboard.db
# SQLite does not require DB_HOST/DB_PORT/DB_USER/DB_PASSWORD
# Database path defaults to: ./data/chws_dashboard.db

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OpenMRS FHIR
OPENMRS_BASE_URL=http://localhost:8080/openmrs/ws/fhir2/R4
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123

# eCHIS API
ECHIS_API_URL=https://api.echis.kenya.go.ke/v1
ECHIS_API_KEY=your-echis-api-key

# Sync
SYNC_INTERVAL_MS=300000
SYNC_BATCH_SIZE=100
